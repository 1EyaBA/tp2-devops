{
  "uid": "catalog-sre",
  "title": "Catalog API — SRE (RED + Error Budget)",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "sre",
    "tp2"
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SLO & Error Budget",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Error Budget restant (30 j)",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:error_budget_remaining:ratio30d",
          "legendFormat": "budget",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "min": -1,
          "max": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Disponibilité (SLO 99.5 %)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
