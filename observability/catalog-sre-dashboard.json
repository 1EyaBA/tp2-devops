      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_requests_total{namespace=\"catalog\",path!=\"/health\",status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_requests_total{namespace=\"catalog\",path!=\"/health\"}[1m]))",
